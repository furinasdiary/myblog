---
// 保留原有组件名、设置键和切换事件，内部效果已替换为水蓝气泡。
---

<script>
	import { sakuraConfig } from "@/config";
	import type { SakuraConfig } from "@/types/effectsConfig";
	import type { SakuraManagerLike } from "@/types/sakura-worker";
	import { getStoredSakuraCount } from "@/utils/setting-utils";

	const randomBetween = (min: number, max: number) =>
		min + Math.random() * (max - min);

	class HydroBubbleManager implements SakuraManagerLike {
		config: SakuraConfig;
		isRunning = false;
		private container: HTMLElement | null = null;
		private boundVisibilityChange: (() => void) | null = null;

		constructor(config: SakuraConfig) {
			this.config = config;
		}

		async init() {
			if (
				!this.config.enable ||
				this.isRunning ||
				window.matchMedia("(prefers-reduced-motion: reduce)").matches
			) {
				return;
			}

			document.getElementById("hydro-bubble-layer")?.remove();

			const container = document.createElement("div");
			container.id = "hydro-bubble-layer";
			container.className = "hydro-bubble-layer";
			container.setAttribute("aria-hidden", "true");
			container.style.zIndex = String(this.config.zIndex);

			for (let index = 0; index < this.config.sakuraNum; index++) {
				const bubble = document.createElement("span");
				const scale = randomBetween(
					this.config.size.min,
					this.config.size.max,
				);
				const duration = randomBetween(
					this.config.speed.vertical.min,
					this.config.speed.vertical.max,
				);
				const drift = randomBetween(
					this.config.speed.horizontal.min,
					this.config.speed.horizontal.max,
				);
				const opacity = randomBetween(
					this.config.opacity.min,
					this.config.opacity.max,
				);

				bubble.className = "hydro-bubble";
				if (Math.random() < 0.28) bubble.classList.add("is-iridescent");
				bubble.style.setProperty("--bubble-left", `${Math.random() * 100}%`);
				bubble.style.setProperty("--bubble-size", `${34 * scale}px`);
				bubble.style.setProperty("--bubble-duration", `${duration}s`);
				bubble.style.setProperty(
					"--bubble-delay",
					`${-Math.random() * duration}s`,
				);
				bubble.style.setProperty("--bubble-drift", `${drift}px`);
				bubble.style.setProperty("--bubble-opacity", String(opacity));
				container.appendChild(bubble);
			}

			document.body.appendChild(container);
			this.container = container;
			this.isRunning = true;

			this.boundVisibilityChange = () => {
				this.container?.classList.toggle("is-paused", document.hidden);
			};
			document.addEventListener(
				"visibilitychange",
				this.boundVisibilityChange,
			);
		}

		stop() {
			if (this.boundVisibilityChange) {
				document.removeEventListener(
					"visibilitychange",
					this.boundVisibilityChange,
				);
				this.boundVisibilityChange = null;
			}
			this.container?.remove();
			this.container = null;
			this.isRunning = false;
		}

		getIsRunning() {
			return this.isRunning;
		}
	}

	let globalSakuraManager: SakuraManagerLike | null = null;

	function initSakura(config: SakuraConfig) {
		if (globalSakuraManager) {
			if (globalSakuraManager.isRunning) globalSakuraManager.stop();
			globalSakuraManager.config = config;
			if (config.enable) void globalSakuraManager.init();
			return;
		}

		globalSakuraManager = new HydroBubbleManager(config);
		window.sakuraManager = globalSakuraManager;
		if (config.enable) void globalSakuraManager.init();
	}

	(function setupHydroBubbles() {
		if (window.sakuraInitialized) return;
		window.sakuraInitialized = true;

		const storedEnabled = localStorage.getItem("sakuraEnabled");
		const isEnabled =
			storedEnabled !== null ? storedEnabled === "true" : sakuraConfig.enable;
		const config: SakuraConfig = Object.assign({}, sakuraConfig, {
			enable: isEnabled,
			sakuraNum: getStoredSakuraCount(),
		});
		initSakura(config);

		window.addEventListener("sakuraToggle", (event: Event) => {
			const detail = (event as CustomEvent<{ enabled: boolean }>).detail;
			const manager = window.sakuraManager;
			if (!detail || !manager) return;

			manager.config.enable = detail.enabled;
			if (detail.enabled && !manager.getIsRunning()) {
				void manager.init();
			} else if (!detail.enabled && manager.getIsRunning()) {
				manager.stop();
			}
		});

		window.addEventListener("sakuraCountChange", (event: Event) => {
			const detail = (event as CustomEvent<{ count: number }>).detail;
			const manager = window.sakuraManager;
			if (!detail || !manager || !Number.isFinite(detail.count)) return;

			manager.config.sakuraNum = detail.count;
			if (manager.getIsRunning()) {
				manager.stop();
				void manager.init();
			}
		});
	})();
</script>

<style is:global>
	.hydro-bubble-layer {
		position: fixed;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		contain: strict;
	}

	.hydro-bubble-layer.is-paused .hydro-bubble {
		animation-play-state: paused;
	}

	.hydro-bubble {
		position: absolute;
		left: var(--bubble-left);
		bottom: calc(var(--bubble-size) * -1.5);
		width: var(--bubble-size);
		height: var(--bubble-size);
		border: 1px solid rgba(174, 234, 255, 0.82);
		border-radius: 50%;
		background:
			radial-gradient(
				circle at 29% 24%,
				rgba(255, 255, 255, 0.96) 0 4%,
				rgba(255, 255, 255, 0.28) 5%,
				transparent 14%
			),
			radial-gradient(
				circle at 64% 70%,
				rgba(20, 164, 235, 0.12),
				rgba(113, 213, 255, 0.08) 42%,
				transparent 72%
			);
		box-shadow:
			inset 2px 3px 7px rgba(255, 255, 255, 0.32),
			inset -3px -4px 8px rgba(20, 153, 225, 0.16),
			0 0 7px rgba(66, 190, 246, 0.22);
		opacity: 0;
		animation: hydro-bubble-rise var(--bubble-duration) linear var(--bubble-delay)
			infinite;
		will-change: transform, opacity;
	}

	.hydro-bubble::after {
		content: "";
		position: absolute;
		inset: 14%;
		border-top: 1px solid rgba(255, 255, 255, 0.78);
		border-left: 1px solid rgba(218, 247, 255, 0.5);
		border-radius: 50%;
		opacity: 0.72;
	}

	.hydro-bubble.is-iridescent {
		border-color: rgba(211, 242, 255, 0.86);
		box-shadow:
			inset 3px 2px 8px rgba(255, 255, 255, 0.42),
			inset -4px -3px 9px rgba(52, 164, 255, 0.18),
			0 0 8px rgba(85, 198, 255, 0.3),
			0 0 2px rgba(229, 170, 255, 0.4);
	}

	@keyframes hydro-bubble-rise {
		0% {
			opacity: 0;
			transform: translate3d(0, 20px, 0) scale(0.72);
		}
		8% {
			opacity: var(--bubble-opacity);
		}
		48% {
			transform: translate3d(calc(var(--bubble-drift) * 0.5), -55vh, 0)
				scale(1);
		}
		88% {
			opacity: var(--bubble-opacity);
		}
		100% {
			opacity: 0;
			transform: translate3d(var(--bubble-drift), -112vh, 0) scale(0.86);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hydro-bubble-layer {
			display: none;
		}
	}
</style>
