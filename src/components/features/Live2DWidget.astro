---
import { url } from "@/utils/url-utils";

interface MenuItem {
	icon?: string;
	label: string;
	action: string;
}

interface Props {
	config: {
		enable: boolean;
		model:
			| {
					path: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }
			| {
					path: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }[];
		position?: "bottom-left" | "bottom-right";
		size?: number | { width: number; height: number };
		primaryColor?: string;
		transitionDuration?: number;
		transitionType?: "slide" | "fade";
		menus?: {
			items?: MenuItem[];
			extraItems?: MenuItem[];
			align?: "left" | "right";
		};
		tips?: {
			enable?: boolean;
			welcomeMessage?: string[];
			messages?: string[];
			duration?: number;
			interval?: number;
			offset?: { x?: number; y?: number };
			typing?: {
				param?: string;
				speed?: number;
				minValue?: number;
				maxValue?: number;
			};
		};
		interactive?: {
			enabled?: boolean;
			clickExpressions?: string[];
			clickEffects?: string[];
			clickCooldown?: number;
			expressionDuration?: number;
			resetExpression?: string;
		};
		responsive?: {
			hideOnMobile?: boolean;
			mobileBreakpoint?: number;
			mobileSize?: number | { width: number; height: number };
			mobileMenuOffsetY?: number;
		};
	};
}

const { config } = Astro.props;

// 构建模型配置
const models = Array.isArray(config.model) ? config.model : [config.model];
const resolvePath = (p: string) => (/^https?:\/\//.test(p) ? p : url(p));

const modelConfigs = models.map((m) => ({
	path: resolvePath(m.path),
	...(m.volume !== undefined && { volume: m.volume }),
	...(m.scale !== undefined && { scale: m.scale }),
	...((m.x !== undefined || m.y !== undefined) && {
		offset: [m.x ?? 0, m.y ?? 0],
	}),
}));

// 序列化菜单配置（只保留 icon, label, action）
function serializeMenus(menus: Props["config"]["menus"]) {
	if (!menus) return {};
	const serialize = (items: MenuItem[]) =>
		items.map(({ icon, label, action }) => ({ icon, label, action }));
	const result: {
		items?: ReturnType<typeof serialize>;
		extraItems?: ReturnType<typeof serialize>;
		align?: string;
	} = {};
	if (menus.items) result.items = serialize(menus.items);
	if (menus.extraItems) result.extraItems = serialize(menus.extraItems);
	if (menus.align) result.align = menus.align;
	return result;
}
---

<div
	id="l2d-widget-container"
	style="position: fixed; z-index: 999;"
	data-home-url={url("/")}
	data-models={JSON.stringify(modelConfigs)}
	data-position={config.position || "bottom-left"}
	data-size={JSON.stringify(config.size || 300)}
	data-primary-color={config.primaryColor || ""}
	data-transition-duration={config.transitionDuration?.toString() || ""}
	data-transition-type={config.transitionType || ""}
	data-menus={JSON.stringify(serializeMenus(config.menus))}
	data-tips={JSON.stringify(config.tips || {})}
	data-interactive={JSON.stringify(config.interactive || {})}
	data-responsive={JSON.stringify(config.responsive || {})}
>
</div>

<script>
	import { createWidget } from "l2d-widget";

	// 修复 l2d-widget 气泡 不会自动换行
	// l2d-widget 使用行内样式，CSS 无法覆盖，需用 JS 修改
	function patchTipBubble(el: HTMLElement) {
		if (el.style.whiteSpace === "nowrap") {
			el.style.whiteSpace = "normal";
			el.style.width = "190px";
		}
	}

	const tipObserver = new MutationObserver((mutations) => {
		for (const m of mutations) {
			for (const node of m.addedNodes) {
				if (node instanceof HTMLElement) {
					if (node.style.whiteSpace === "nowrap") patchTipBubble(node);
					node.querySelectorAll<HTMLElement>('*').forEach(patchTipBubble);
				}
			}
		}
	});
	tipObserver.observe(document.body, { childList: true, subtree: true });

	// 菜单动作映射
	let currentModelIndex = 0;
	const menuActions: Record<string, (widget: any) => void> = {
		home: () => {
			const container = document.getElementById("l2d-widget-container");
			window.location.href = container?.dataset.homeUrl || "/";
		},
		scrollToTop: () => window.scrollTo({ top: 0, behavior: "smooth" }),
		sleep: (widget) => widget.sleep(),
		github: () =>
			window.open(
				"https://github.com/furinasdiary/furinasdiary.github.io",
				"_blank",
			),
		switchModel: (widget) => {
			const container = document.getElementById("l2d-widget-container");
			const models = JSON.parse(container?.dataset.models || "[]");
			currentModelIndex = (currentModelIndex + 1) % models.length;
			widget.switchModel(currentModelIndex);
		},
	};

	function showClickParticles(x: number, y: number, effects: string[]) {
		const particles = effects.length > 0 ? effects : ["💙", "✨", "💧"];
		const count = Math.min(3, particles.length);

		for (let index = 0; index < count; index++) {
			const particle = document.createElement("span");
			particle.textContent =
				particles[Math.floor(Math.random() * particles.length)];
			Object.assign(particle.style, {
				position: "fixed",
				left: `${x + (index - 1) * 12}px`,
				top: `${y}px`,
				zIndex: "10001",
				pointerEvents: "none",
				userSelect: "none",
				fontSize: `${17 + index * 2}px`,
				filter: "drop-shadow(0 0 6px rgba(14, 165, 233, 0.9))",
			});
			document.body.appendChild(particle);

			const drift = (Math.random() - 0.5) * 30;
			const animation = particle.animate(
				[
					{
						transform: "translate(-50%, -20%) scale(0.65)",
						opacity: 0,
					},
					{
						transform: "translate(-50%, -45%) scale(1)",
						opacity: 1,
						offset: 0.25,
					},
					{
						transform: `translate(calc(-50% + ${drift}px), -${60 + index * 12}px) scale(1.15)`,
						opacity: 0,
					},
				],
				{
					duration: 850 + index * 100,
					delay: index * 45,
					easing: "ease-out",
					fill: "forwards",
				},
			);

			animation.finished
				.then(() => particle.remove())
				.catch(() => particle.remove());
		}
	}

	function setupClickInteraction(widget: any, interactive: any) {
		if (interactive.enabled === false) return;

		const expressions = Array.isArray(interactive.clickExpressions)
			? interactive.clickExpressions
			: [];
		if (expressions.length === 0) return;

		const effects = Array.isArray(interactive.clickEffects)
			? interactive.clickEffects
			: [];
		const cooldown = Math.max(0, interactive.clickCooldown ?? 700);
		const expressionDuration = Math.max(
			0,
			interactive.expressionDuration ?? 1600,
		);
		const resetExpression =
			typeof interactive.resetExpression === "string"
				? interactive.resetExpression
				: "expression1.exp3.json";
		let lastClickAt = 0;
		let resetTimer: number | undefined;

		document.addEventListener(
			"click",
			(event) => {
				const l2d = widget.l2d as any;
				const canvas = l2d?.getCanvas?.() ?? l2d?.canvas;
				if (!(canvas instanceof HTMLCanvasElement) || event.target !== canvas) {
					return;
				}

				const now = Date.now();
				if (now - lastClickAt < cooldown) return;
				lastClickAt = now;

				const expression =
					expressions[Math.floor(Math.random() * expressions.length)];
				l2d.setExpression?.(expression);
				if (resetTimer !== undefined) {
					window.clearTimeout(resetTimer);
				}
				resetTimer = window.setTimeout(() => {
					const activeL2d = widget.l2d as any;
					activeL2d?.setExpression?.(resetExpression);
					resetTimer = undefined;
				}, expressionDuration);
				showClickParticles(event.clientX, event.clientY, effects);
			},
			{ passive: true },
		);
	}

	function initWidget() {
		const container = document.getElementById("l2d-widget-container");
		if (!container) return;

		try {
			const models = JSON.parse(container.dataset.models || "[]");
			const position = container.dataset.position || "bottom-left";
			const desktopSize = JSON.parse(container.dataset.size || '300');
			const primaryColor = container.dataset.primaryColor || undefined;
			const transitionDuration = container.dataset.transitionDuration
				? parseInt(container.dataset.transitionDuration)
				: undefined;
			const transitionType = container.dataset.transitionType || undefined;
			const menus = JSON.parse(container.dataset.menus || "{}");
			const tips = JSON.parse(container.dataset.tips || "{}");
			const interactive = JSON.parse(container.dataset.interactive || "{}");
			const responsive = JSON.parse(container.dataset.responsive || '{}');
			const breakpoint = responsive.mobileBreakpoint || 768;
			const size =
				window.innerWidth <= breakpoint && responsive.mobileSize
					? responsive.mobileSize
					: desktopSize;

			if (
				window.innerWidth <= breakpoint &&
				responsive.mobileMenuOffsetY !== undefined
			) {
				menus.style = {
					...(menus.style || {}),
					transform: `translateY(-50%) translateY(${responsive.mobileMenuOffsetY}px)`,
				};
			}

			// 响应式检查：移动端隐藏
			if (responsive.hideOnMobile) {
				if (window.innerWidth <= breakpoint) {
					container.style.display = "none";
					return;
				}
			}

			if (models.length === 0) {
				console.warn("No Live2D models configured");
				return;
			}

			const options: any = {
				model: models.length === 1 ? models[0] : models,
				position: position,
				size: size,
			};

			if (primaryColor) options.primaryColor = primaryColor;
			if (transitionDuration) options.transitionDuration = transitionDuration;
			if (transitionType) options.transitionType = transitionType;

			// 菜单配置 - 将 action 字符串映射为实际函数
			if (menus.items || (menus.extraItems && menus.extraItems.length > 0)) {
				options.menus = {};
				if (menus.items) {
					options.menus.items = menus.items.map((item: any) => ({
						icon: item.icon,
						label: item.label,
						onClick: menuActions[item.action] || (() => {}),
					}));
				}
				if (menus.extraItems) {
					options.menus.extraItems = menus.extraItems.map((item: any) => ({
						icon: item.icon,
						label: item.label,
						onClick: menuActions[item.action] || (() => {}),
					}));
				}
				if (menus.align) {
					options.menus.align = menus.align;
				}
			}

			// 提示配置
			if (tips) {
				const tipsConfig = tips.enable === false ? false : {
					...(tips.welcomeMessage && { welcomeMessage: tips.welcomeMessage }),
					...(tips.messages && { messages: tips.messages }),
					...(tips.duration !== undefined && { duration: tips.duration }),
					...(tips.interval !== undefined && { interval: tips.interval }),
					...(tips.offset && { offset: tips.offset }),
					...(tips.typing && { typing: tips.typing }),
				};
				
				if (tipsConfig === false || Object.keys(tipsConfig).length > 0) {
					if (Array.isArray(options.model)) {
						options.model.forEach((m: any) => m.tips = tipsConfig);
					} else {
						options.model.tips = tipsConfig;
					}
				}
			}

			const widget = createWidget(options);
			setupClickInteraction(widget, interactive);
		} catch (e) {
			console.error("Failed to initialize Live2D widget:", e);
		}
	}

	// 确保只初始化一次
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initWidget);
	} else {
		initWidget();
	}

	// 响应式处理：窗口大小变化时显示/隐藏
	function handleResponsive() {
		const container = document.getElementById("l2d-widget-container");
		if (!container) return;

		const responsive = JSON.parse(container.dataset.responsive || "{}");
		if (responsive.hideOnMobile) {
			const breakpoint = responsive.mobileBreakpoint || 768;
			if (window.innerWidth <= breakpoint) {
				container.style.display = "none";
			} else {
				container.style.display = "";
			}
		}
	}

	window.addEventListener("resize", handleResponsive);
</script>
